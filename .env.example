# Copy to .env for local testing only. NEVER commit a real .env file.
# In GitHub Actions, these are set as repo Secrets instead — see README.

DA_SUPABASE_URL=
DA_SUPABASE_SERVICE_KEY=

QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REALM_ID=
QB_ENVIRONMENT=production               # sandbox | production
# QB_REFRESH_TOKEN is only used to bootstrap the FIRST run (from the OAuth
# Playground consent step). After that, the connector reads/writes the
# current (rotated) token from/to the qb_oauth_credentials table instead --
# QuickBooks rotates this token on every use, so the .env value goes stale
# immediately after the first successful run.
QB_REFRESH_TOKEN=

AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Project Tracking

SOCIALBLADE_CLIENT_ID=
SOCIALBLADE_TOKEN=

BREX_API_TOKEN=

PAYPAL_CLIENT_ID_DANI=
PAYPAL_CLIENT_SECRET_DANI=
PAYPAL_CLIENT_ID_KATELYN=
PAYPAL_CLIENT_SECRET_KATELYN=

# Shared across the whole EGE family office -- returns 5 accounts, this
# connector filters down to only Dani Austin's. See plaid_connector.py.
PLAID_CLIENT_ID=
PLAID_SECRET=                            # Production/Trial secret, NOT Sandbox
PLAID_ACCESS_TOKEN=
PLAID_ENV=production                     # sandbox | production
PLAID_DA_ACCOUNT_ID=Kna3BME5DDiwKg7OB459I0wm36E3RPFEAp9ng

META_SYSTEM_USER_TOKEN=
